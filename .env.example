# IA: GPT-5 mini por Vercel AI Gateway (en Vercel no hace falta clave)
AI_MODEL=openai/gpt-5-mini

# Upstash Redis (Vercel > Storage): memoria de charlas y chats desactivados
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# WhatsApp Cloud API (developers.facebook.com > tu app > WhatsApp)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=pictureweb-wa
WHATSAPP_APP_SECRET=

# Tu WhatsApp personal para avisos de leads y comandos /bot (opcional)
OWNER_PHONE=
# Números que el bot NUNCA contesta, separados por coma (ej: 5491122334455,5493484000000)
BOT_OFF_NUMBERS=

# Protege /api/instagram-refresh
CRON_SECRET=

# Instagram (opcional, pendiente de la revisión de Meta)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_CONFIG_ID=
INSTAGRAM_VERIFY_TOKEN=pictureweb-ig
