# IA: GPT-5 mini por Vercel AI Gateway (en Vercel no hace falta clave)
AI_MODEL=openai/gpt-5-mini

# Contraseña de la página del QR
ADMIN_PASSWORD=

# Protege el cron (Vercel la manda sola)
CRON_SECRET=

# Upstash Redis: guarda la sesión de WhatsApp y las charlas (Vercel > Storage > Upstash)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Opcional: número para avisos de leads (si está vacío, te llegan a tu chat "Mensaje para mí")
OWNER_PHONE=

# Instagram (developers.facebook.com > tu app > Instagram > Configuración de la API con inicio de sesión de Instagram)
INSTAGRAM_VERIFY_TOKEN=pictureweb-ig
INSTAGRAM_APP_SECRET=
INSTAGRAM_TOKEN=
