# IA: GPT-5 mini por Vercel AI Gateway. En Vercel no hace falta clave (usa OIDC del proyecto).
AI_MODEL=openai/gpt-5-mini

# WhatsApp Cloud API (developers.facebook.com > tu app > WhatsApp > Configuración de la API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=pictureweb2026
WHATSAPP_APP_SECRET=

# Tu WhatsApp personal para avisos de leads (ej: 5493484699281)
OWNER_PHONE=

# Memoria de chats: conectá Upstash desde Vercel > Storage (se cargan solas)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
